pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _draw()
  cls(0)
  map(0, 0)
  -- mammoth
  spr(5, 44, 40)
  spr(6, 52, 40)
  spr(7, 44, 48)
  spr(8, 52, 48)
  -- player camp (left)
  spr(16, 8, 96)
  spr(14, 24, 104)
  spr(9, 20, 104)
  -- bots (right)
  spr(10, 88, 104)
  spr(10, 104, 104)
  spr(14, 96, 104)
  -- rewards
  spr(11, 44, 112)
  spr(12, 60, 112)
  spr(13, 76, 112)
  print("mammoth hunt preview", 2, 2, 7)
end
